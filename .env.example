# ReviewMindBot configuration.
# Copy to .env and fill in the provider you actually use.

# --- Provider -----------------------------------------------------------
# One of: gemini, openai, groq   (default: gemini)
LLM_PROVIDER=gemini

# Google Gemini - https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted (that is the name the Google SDK uses).
GEMINI_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# Override the provider's default model.
# REVIEWMINDBOT_MODEL=gemini-2.5-flash

# --- GitHub -------------------------------------------------------------
# Needed for private repositories and to raise the anonymous rate limit.
# Posting review comments (--comment) additionally needs `pull-requests: write`.
GITHUB_TOKEN=

# --- Cost control -------------------------------------------------------
# Hard spend ceiling per run, in USD. Empty means unlimited. When the ceiling
# is reached the run stops and reports a partial review rather than failing.
BUDGET_USD=

# Responses are cached on disk so re-runs on an unchanged diff are free.
CACHE_ENABLED=1
CACHE_TTL_SECONDS=1209600

# --- Behaviour ----------------------------------------------------------
LOG_LEVEL=INFO
# Defaults to a per-user state directory, not the current folder.
# LOG_FILE=

# Characters of diff per model request, and how much to repeat across a split.
MAX_CHUNK_SIZE=12000
CHUNK_OVERLAP=400

# Chunks reviewed in parallel.
MAX_CONCURRENCY=4

# Per-request timeout (seconds) and retry budget for transient failures.
REQUEST_TIMEOUT=60
MAX_RETRIES=3
