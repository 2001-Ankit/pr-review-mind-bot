# ReviewMindBot Configuration

# LLM Provider: "gemini" or "openai" (default: gemini)
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get it at: https://ai.google.dev/gemini-api
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=reviewmindbot.log

# Diff Chunking Configuration
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
